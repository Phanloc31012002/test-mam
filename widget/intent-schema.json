{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mầm optional intent extraction contract",
  "description": "Future server-side model output only. Not loaded by the local widget. Unknown or unconfirmed slots must be null; this output is not a quotation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intent",
    "productId",
    "quantity",
    "quantityUnit",
    "size",
    "pages",
    "material",
    "finishing"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "intent": {
      "type": "string",
      "enum": [
        "price_lookup",
        "published_total_lookup",
        "discount_request",
        "deadline_request",
        "services",
        "address",
        "hours",
        "email",
        "delivery",
        "contact",
        "greeting",
        "reset",
        "clarify",
        "out_of_scope",
        "unknown"
      ]
    },
    "productId": {
      "type": ["string", "null"],
      "enum": [
        "namecard-c300",
        "decal-paper",
        "decal-plastic",
        "flyer",
        "catalogue",
        "kraft-bag",
        "paper-box",
        "envelope-a5",
        "red-envelope",
        "menu-paper",
        "receipt",
        "wedding",
        null
      ]
    },
    "quantity": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 10000000
    },
    "quantityUnit": {
      "type": ["string", "null"],
      "enum": ["cuốn", "hộp", "cái", "tờ", "bộ", null]
    },
    "size": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 80
    },
    "pages": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1000
    },
    "material": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100
    },
    "finishing": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160
    }
  }
}
